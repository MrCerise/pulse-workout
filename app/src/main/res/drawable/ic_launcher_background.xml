<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher background layer: the brand navy fading to near-black towards the bottom-right, so the
  mark sits on depth rather than on a flat swatch. Drawn across the whole 108x108 adaptive canvas —
  the launcher masks it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="12" android:startY="0"
                android:endX="96" android:endY="108">
                <item android:offset="0" android:color="#FF1B2340" />
                <item android:offset="1" android:color="#FF0A0E1C" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
