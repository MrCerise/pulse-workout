<?xml version="1.0" encoding="utf-8"?>
<!--
  PULSE launcher mark.

  Two ideas, one shape:
   - a **segmented timer ring** — the long lime arc is a work interval, the short cyan arc the rest
     that follows it, so the icon reads as an interval session rather than a generic stopwatch;
   - a **pulse trace** through the middle, which is where the name comes from.

  Everything is drawn inside a 64 dp circle centred on the 108 dp adaptive canvas, so it survives
  the circular, squircle and rounded-square masks launchers apply.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- Work segment: 200 degrees of the ring. -->
    <path android:strokeColor="#C6F463" android:strokeWidth="4"
        android:strokeLineCap="round" android:fillColor="#00000000"
        android:pathData="M44.08,26.75 A29,29 0 1 1 54,83" />

    <!-- Rest segment: the remaining 140 degrees, separated by a 10 degree gap each side. -->
    <path android:strokeColor="#5FE3F5" android:strokeWidth="4"
        android:strokeLineCap="round" android:fillColor="#00000000"
        android:pathData="M48.96,82.56 A29,29 0 0 1 39.5,28.89" />

    <!-- The pulse itself. -->
    <path android:strokeColor="#F6F8FE" android:strokeWidth="6"
        android:strokeLineCap="round" android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M34,54 H43 L49,41 L57,69 L63,54 H74" />
</vector>
