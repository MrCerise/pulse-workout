<?xml version="1.0" encoding="utf-8"?>
<!--
  PULSE design tokens shared between XML themes/widgets and Compose (see ui/theme/Color.kt).
  Measured WCAG contrast ratios for these pairings are documented in docs/CONTRAST.md and are
  produced by scripts/contrast_check.py, which reads this file.
-->
<resources>
    <!-- Dark theme (default look) -->
    <color name="pulse_background">#0B1020</color>
    <color name="pulse_surface">#151B2D</color>
    <color name="pulse_surface_raised">#1E263C</color>
    <color name="pulse_text_primary">#F5F7FB</color>
    <color name="pulse_text_secondary">#AAB4C8</color>
    <color name="pulse_outline">#5A688A</color>

    <!-- Interval colours (dark theme) — always paired with dark text on the fill -->
    <color name="pulse_work">#B8F267</color>
    <color name="pulse_rest">#65D9EF</color>
    <color name="pulse_prepare">#FFCA7A</color>
    <color name="pulse_cooldown">#B9A6FF</color>
    <color name="pulse_destructive">#FF727D</color>
    <color name="pulse_on_accent">#0B1020</color>

    <!-- Light theme -->
    <color name="pulse_light_background">#F5F7FC</color>
    <color name="pulse_light_surface">#FFFFFF</color>
    <color name="pulse_light_surface_raised">#EDF1F9</color>
    <color name="pulse_light_text_primary">#101426</color>
    <color name="pulse_light_text_secondary">#4C5670</color>
    <color name="pulse_light_outline">#7F8798</color>
    <color name="pulse_light_work">#3F6F0B</color>
    <color name="pulse_light_rest">#0B6076</color>
    <color name="pulse_light_prepare">#8A4B00</color>
    <color name="pulse_light_cooldown">#4C33B8</color>
    <color name="pulse_light_destructive">#B32638</color>

    <!--
      Material tonal ramp (dark). Material3 components — dialogs, menus, the bottom navigation bar,
      chips, switches — take their container colour from here, so nothing falls back to the
      framework's stock purple-grey on top of the navy surfaces.
    -->
    <color name="pulse_container_lowest">#070B17</color>
    <color name="pulse_container_low">#101627</color>
    <color name="pulse_container">#151B2D</color>
    <color name="pulse_container_high">#1E263C</color>
    <color name="pulse_container_highest">#27314A</color>
    <color name="pulse_surface_dim">#0B1020</color>
    <color name="pulse_surface_bright">#2A3450</color>
    <color name="pulse_outline_variant">#2B3552</color>

    <!-- Role containers (dark) — always paired with their `on` colour -->
    <color name="pulse_primary_container">#2A3A12</color>
    <color name="pulse_on_primary_container">#D9F7A8</color>
    <color name="pulse_secondary_container">#0E3440</color>
    <color name="pulse_on_secondary_container">#B6ECF7</color>
    <color name="pulse_tertiary_container">#2C2258</color>
    <color name="pulse_on_tertiary_container">#D6CCFF</color>
    <color name="pulse_error_container">#4A1520</color>
    <color name="pulse_on_error_container">#FFC2C7</color>

    <!-- Material tonal ramp (light) -->
    <color name="pulse_light_container_lowest">#FFFFFF</color>
    <color name="pulse_light_container_low">#F7F9FE</color>
    <color name="pulse_light_container">#F5F7FC</color>
    <color name="pulse_light_container_high">#EDF1F9</color>
    <color name="pulse_light_container_highest">#E3E9F4</color>
    <color name="pulse_light_surface_dim">#DCE2EE</color>
    <color name="pulse_light_surface_bright">#FFFFFF</color>
    <color name="pulse_light_outline_variant">#D5DBE8</color>

    <!-- Role containers (light) -->
    <color name="pulse_light_primary_container">#D6EFB0</color>
    <color name="pulse_light_on_primary_container">#1B2E00</color>
    <color name="pulse_light_secondary_container">#BDE9F5</color>
    <color name="pulse_light_on_secondary_container">#00262F</color>
    <color name="pulse_light_tertiary_container">#E3DBFF</color>
    <color name="pulse_light_on_tertiary_container">#1F0A63</color>
    <color name="pulse_light_error_container">#FFDAD9</color>
    <color name="pulse_light_on_error_container">#410006</color>

    <!-- True black theme -->
    <color name="pulse_black_background">#000000</color>
    <color name="pulse_black_surface">#0C0C10</color>
    <color name="pulse_black_container_lowest">#000000</color>
    <color name="pulse_black_container_low">#06060A</color>
    <color name="pulse_black_container_high">#14141A</color>
    <color name="pulse_black_container_highest">#1C1C24</color>

    <color name="widget_background">#151B2D</color>
</resources>
