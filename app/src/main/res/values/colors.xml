<?xml version="1.0" encoding="utf-8"?>
<!--
  PULSE design tokens — the "Graphite" system (design reference: Linear).

  One neutral ramp plus a small, purposeful set of signal colours. Every value here is mirrored,
  name for name, in ui/theme/Palette.kt; scripts/contrast_check.py fails with exit code 2 if the two
  ever drift apart, and it fails with exit code 1 if any measured pairing drops below its WCAG 2.1 AA
  threshold. docs/DESIGN.md explains which token belongs where; docs/CONTRAST.md holds the numbers.

  Dark is the default. The light and true-black ramps reuse the dark signal colours wherever the
  measured contrast allows it, which is why the phase colours are declared only once.
-->
<resources>

    <!-- ============================ Cockpit — the default (dark) theme ============================ -->

    <!-- Surfaces. Four steps, no more: canvas (app background), surface (cards and panels),
         raised (inputs, stat tiles, chips) and overlay (menus, dialogs, sheets). The steps are
         deliberately close together: hierarchy comes from hairline borders, not from brightness
         jumps, which is what stops the interface from glowing. -->
    <color name="pulse_canvas">#08090A</color>
    <color name="pulse_nav">#0B0C0E</color>
    <color name="pulse_surface">#101114</color>
    <color name="pulse_surface_raised">#16181B</color>
    <color name="pulse_surface_overlay">#1D1F23</color>
    <color name="pulse_surface_hover">#222429</color>

    <!-- Borders. `pulse_border` is a hairline separator and is intentionally low-contrast (it is
         decorative); `pulse_outline` marks a meaningful control boundary and clears 3:1. -->
    <color name="pulse_border">#24272C</color>
    <color name="pulse_outline">#5F6470</color>

    <!-- Text. Four levels, three of which clear 4.5:1; `disabled` is exempt by WCAG and exists so
         that "unavailable" is visually distinct from "quiet" rather than merely dimmer. -->
    <color name="pulse_text_primary">#F7F8F8</color>
    <color name="pulse_text_secondary">#9BA1AE</color>
    <color name="pulse_text_muted">#7A818F</color>
    <color name="pulse_text_disabled">#4B5058</color>

    <!-- The single interactive accent: selection, links, focus, live data. Never decoration. -->
    <color name="pulse_accent">#7C8CFF</color>
    <color name="pulse_accent_tint">#1F2235</color>

    <!-- Interval phases. The only chromatic elements in the running interface: one hue per phase,
         each shipped with the pre-composited container tint it is drawn on. -->
    <color name="pulse_work">#4CC38A</color>
    <color name="pulse_work_tint">#182A25</color>
    <color name="pulse_rest">#5BC8E8</color>
    <color name="pulse_rest_tint">#1A2B32</color>
    <color name="pulse_prepare">#E3B341</color>
    <color name="pulse_prepare_tint">#2E281A</color>
    <color name="pulse_cooldown">#A78BFA</color>
    <color name="pulse_cooldown_tint">#252234</color>
    <color name="pulse_destructive">#F2555A</color>
    <color name="pulse_destructive_tint">#301B1E</color>
    <color name="pulse_neutral_fill">#222429</color>

    <!-- Solid action surfaces. The primary action inverts the text ramp instead of introducing a
         brand colour, which keeps the accent free to mean "interactive". -->
    <color name="pulse_action_fill">#F7F8F8</color>
    <color name="pulse_action_text">#08090A</color>
    <color name="pulse_on_accent">#0A0B0D</color>

    <!-- ============================ Daylight — the light theme ============================ -->

    <color name="pulse_light_canvas">#F7F8FA</color>
    <color name="pulse_light_nav">#FFFFFF</color>
    <color name="pulse_light_surface">#FFFFFF</color>
    <color name="pulse_light_surface_raised">#F3F4F7</color>
    <color name="pulse_light_surface_overlay">#FFFFFF</color>
    <color name="pulse_light_surface_hover">#ECEEF2</color>
    <color name="pulse_light_border">#E6E8EC</color>
    <color name="pulse_light_outline">#767C88</color>
    <color name="pulse_light_text_primary">#14161A</color>
    <color name="pulse_light_text_secondary">#545B68</color>
    <color name="pulse_light_text_muted">#656B77</color>
    <color name="pulse_light_text_disabled">#A3A8B2</color>
    <color name="pulse_light_accent">#3D4FD6</color>
    <color name="pulse_light_accent_tint">#ECEDFB</color>
    <color name="pulse_light_work">#177245</color>
    <color name="pulse_light_work_tint">#E8F1EC</color>
    <color name="pulse_light_rest">#0B6E85</color>
    <color name="pulse_light_rest_tint">#E7F0F3</color>
    <color name="pulse_light_prepare">#8A5A00</color>
    <color name="pulse_light_prepare_tint">#F3EEE6</color>
    <color name="pulse_light_cooldown">#5B3FD1</color>
    <color name="pulse_light_cooldown_tint">#EFECFA</color>
    <color name="pulse_light_destructive">#BE2F3C</color>
    <color name="pulse_light_destructive_tint">#F8EAEC</color>
    <color name="pulse_light_neutral_fill">#EDEFF3</color>
    <color name="pulse_light_action_fill">#14161A</color>
    <color name="pulse_light_action_text">#FFFFFF</color>
    <color name="pulse_light_on_accent">#FFFFFF</color>

    <!-- ============================ True black — the OLED theme ============================ -->
    <!-- Only the surfaces change: pure black saves power on OLED panels, and the ramp above already
         clears every threshold against #000000 (verified as its own section in docs/CONTRAST.md). -->

    <color name="pulse_black_canvas">#000000</color>
    <color name="pulse_black_nav">#000000</color>
    <color name="pulse_black_surface">#0A0A0C</color>
    <color name="pulse_black_surface_raised">#131316</color>
    <color name="pulse_black_surface_overlay">#191A1D</color>
    <color name="pulse_black_surface_hover">#1E1F23</color>
    <color name="pulse_black_border">#1C1D21</color>

    <!-- ============================ Widgets ============================ -->
    <!-- RemoteViews can only reference resources, so the widget surfaces are aliases rather than
         copies: change the design system and the home-screen widget follows automatically. -->

    <color name="widget_background">@color/pulse_surface</color>
    <color name="widget_row_background">@color/pulse_surface_raised</color>
    <color name="widget_phase_work">@color/pulse_work</color>
    <color name="widget_phase_rest">@color/pulse_rest</color>
    <color name="widget_phase_prepare">@color/pulse_prepare</color>

</resources>
