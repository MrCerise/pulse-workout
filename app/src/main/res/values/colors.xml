<?xml version="1.0" encoding="utf-8"?>
<!--
  PULSE design tokens shared between XML themes/widgets and Compose (see ui/theme/Theme.kt).
  Measured WCAG contrast ratios for these pairings are documented in docs/CONTRAST.md and are
  produced by scripts/contrast_check.py, which reads this file.

  v1.3 "Aurora" palette: deeper midnight navy, brighter interval colours, full tonal ramps.
-->
<resources>
    <!-- Dark theme (default look) -->
    <color name="pulse_background">#0A0E1C</color>
    <color name="pulse_surface">#121831</color>
    <color name="pulse_surface_raised">#1B2340</color>
    <color name="pulse_text_primary">#F6F8FE</color>
    <color name="pulse_text_secondary">#A8B2CE</color>
    <color name="pulse_outline">#5C6A92</color>

    <!-- Interval colours (dark theme) — always paired with dark text on the fill -->
    <color name="pulse_work">#C6F463</color>
    <color name="pulse_rest">#5FE3F5</color>
    <color name="pulse_prepare">#FFCF87</color>
    <color name="pulse_cooldown">#C6B5FF</color>
    <color name="pulse_destructive">#FF7B87</color>
    <color name="pulse_on_accent">#0A0E1C</color>

    <!-- Light theme -->
    <color name="pulse_light_background">#F6F8FD</color>
    <color name="pulse_light_surface">#FFFFFF</color>
    <color name="pulse_light_surface_raised">#ECF0F9</color>
    <color name="pulse_light_text_primary">#111527</color>
    <color name="pulse_light_text_secondary">#4E5873</color>
    <color name="pulse_light_outline">#818AA0</color>
    <color name="pulse_light_work">#3E6E0A</color>
    <color name="pulse_light_rest">#0A5F77</color>
    <color name="pulse_light_prepare">#8A4E00</color>
    <color name="pulse_light_cooldown">#4D34BA</color>
    <color name="pulse_light_destructive">#B42638</color>

    <!--
      Material tonal ramp (dark). Material3 components — dialogs, menus, the bottom navigation bar,
      chips, switches — take their container colour from here, so nothing falls back to the
      framework's stock purple-grey on top of the navy surfaces.
    -->
    <color name="pulse_container_lowest">#060913</color>
    <color name="pulse_container_low">#0E1428</color>
    <color name="pulse_container">#121831</color>
    <color name="pulse_container_high">#1B2340</color>
    <color name="pulse_container_highest">#242E52</color>
    <color name="pulse_surface_dim">#0A0E1C</color>
    <color name="pulse_surface_bright">#2D3A66</color>
    <color name="pulse_outline_variant">#2B355C</color>

    <!-- Role containers (dark) — always paired with their `on` colour -->
    <color name="pulse_primary_container">#2F4512</color>
    <color name="pulse_on_primary_container">#DBF7A9</color>
    <color name="pulse_secondary_container">#0D3846</color>
    <color name="pulse_on_secondary_container">#BDEFFB</color>
    <color name="pulse_tertiary_container">#2E2360</color>
    <color name="pulse_on_tertiary_container">#DAD1FF</color>
    <color name="pulse_error_container">#4D161F</color>
    <color name="pulse_on_error_container">#FFC6CB</color>

    <!-- Material tonal ramp (light) -->
    <color name="pulse_light_container_lowest">#FFFFFF</color>
    <color name="pulse_light_container_low">#F8FAFE</color>
    <color name="pulse_light_container">#F6F8FD</color>
    <color name="pulse_light_container_high">#ECF0F9</color>
    <color name="pulse_light_container_highest">#E2E8F4</color>
    <color name="pulse_light_surface_dim">#DBE1EE</color>
    <color name="pulse_light_surface_bright">#FFFFFF</color>
    <color name="pulse_light_outline_variant">#D3DAE8</color>

    <!-- Role containers (light) -->
    <color name="pulse_light_primary_container">#D7F0A4</color>
    <color name="pulse_light_on_primary_container">#20350A</color>
    <color name="pulse_light_secondary_container">#BCEAF6</color>
    <color name="pulse_light_on_secondary_container">#00303D</color>
    <color name="pulse_light_tertiary_container">#E4DFFF</color>
    <color name="pulse_light_on_tertiary_container">#221063</color>
    <color name="pulse_light_error_container">#FFD9DB</color>
    <color name="pulse_light_on_error_container">#410006</color>

    <!-- True black theme -->
    <color name="pulse_black_background">#000000</color>
    <color name="pulse_black_surface">#0B0B10</color>
    <color name="pulse_black_container_lowest">#000000</color>
    <color name="pulse_black_container_low">#060609</color>
    <color name="pulse_black_container_high">#14141B</color>
    <color name="pulse_black_container_highest">#1D1D26</color>

    <color name="widget_background">#121831</color>
</resources>
