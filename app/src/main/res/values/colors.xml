<!--
  PULSE design tokens — the "Prism" system.

  A violet-tinted ink ramp for the dark theme, a cool paper ramp for the light one, a two-stop
  accent (violet -> cyan) that the interface uses as a gradient, and one hue per interval phase.
  Every value here is mirrored, name for name, in ui/theme/Palette.kt; scripts/contrast_check.py
  fails with exit code 2 if the two ever drift apart, and it fails with exit code 1 if any measured
  pairing drops below its WCAG 2.1 AA threshold. docs/DESIGN.md explains which token belongs where;
  docs/CONTRAST.md holds the numbers.

  Dark is the default. Each theme is built from the same roles, so a component never has to know
  which theme it is in — it reads semantic tokens from PulseColors and the resolution happens once,
  in Theme.kt.
-->
<resources>

    <!-- ============================ Ink — the default (dark) theme ============================ -->

    <!-- Surfaces. Five steps: canvas (app background), surface (cards), raised (inputs, tiles),
         overlay (menus, dialogs, sheets) and hover (pressed and hover feedback). The steps are
         close together because hierarchy in Prism comes from fill plus a hairline plus, where it
         matters, real elevation — not from brightness jumps. -->
    <color name="pulse_canvas">#0A0912</color>
    <color name="pulse_nav">#120F1C</color>
    <color name="pulse_surface">#171423</color>
    <color name="pulse_surface_raised">#1F1B2E</color>
    <color name="pulse_surface_overlay">#272137</color>
    <color name="pulse_surface_hover">#2E2842</color>

    <!-- Borders. `pulse_border` is a hairline separator and is intentionally low-contrast (it is
         decorative); `pulse_outline` marks a meaningful control boundary and clears 3:1. -->
    <color name="pulse_border">#2B2540</color>
    <color name="pulse_outline">#8B7FB8</color>

    <!-- Text. Four levels, three of which clear 4.5:1; `disabled` is exempt by WCAG and exists so
         that "unavailable" is visually distinct from "quiet" rather than merely dimmer. -->
    <color name="pulse_text_primary">#F6F4FF</color>
    <color name="pulse_text_secondary">#B9B2D4</color>
    <color name="pulse_text_muted">#948DB4</color>
    <color name="pulse_text_disabled">#5E5780</color>

    <!-- The two-stop accent. `pulse_accent` (violet) is the interactive colour used for text,
         selection and focus; `pulse_accent_alt` (cyan) is its gradient partner and is only ever
         drawn behind or beside the violet, never as text on its own. `pulse_accent_tint` is the
         pre-composited container fill the accent text is measured against. -->
    <color name="pulse_accent">#A78BFA</color>
    <color name="pulse_accent_alt">#22D3EE</color>
    <color name="pulse_accent_tint">#241E3C</color>

    <!-- Interval phases. The only chromatic elements in the running interface: one hue per phase,
         each shipped with the pre-composited container tint it is drawn on. -->
    <color name="pulse_work">#4ADE80</color>
    <color name="pulse_work_tint">#122B1E</color>
    <color name="pulse_rest">#38BDF8</color>
    <color name="pulse_rest_tint">#0E2431</color>
    <color name="pulse_prepare">#FBBF24</color>
    <color name="pulse_prepare_tint">#2E2411</color>
    <color name="pulse_cooldown">#C084FC</color>
    <color name="pulse_cooldown_tint">#251A38</color>
    <color name="pulse_destructive">#FB7185</color>
    <color name="pulse_destructive_tint">#331419</color>
    <color name="pulse_neutral_fill">#2E2842</color>

    <!-- Workout category hues. Six families, one hue each, each with the pre-composited container
         tint it is drawn on. These are the colours the category registry assigns to a workout type,
         so "this is a cardio session" reads before a word is read. -->
    <color name="pulse_cat_cardio">#FB7185</color>
    <color name="pulse_cat_cardio_tint">#331419</color>
    <color name="pulse_cat_conditioning">#FBBF24</color>
    <color name="pulse_cat_conditioning_tint">#2E2411</color>
    <color name="pulse_cat_strength">#A78BFA</color>
    <color name="pulse_cat_strength_tint">#241E3C</color>
    <color name="pulse_cat_mobility">#38BDF8</color>
    <color name="pulse_cat_mobility_tint">#0E2431</color>
    <color name="pulse_cat_mind">#4ADE80</color>
    <color name="pulse_cat_mind_tint">#122B1E</color>
    <color name="pulse_cat_tools">#94A3B8</color>
    <color name="pulse_cat_tools_tint">#1F2637</color>

    <!-- Solid action surfaces. The primary action inverts the text ramp instead of introducing a
         brand colour, which keeps the accent free to mean "interactive". -->
    <color name="pulse_action_fill">#F6F4FF</color>
    <color name="pulse_action_text">#0A0912</color>
    <color name="pulse_on_accent">#0A0912</color>

    <!-- ============================ Paper — the light theme ============================ -->

    <color name="pulse_light_canvas">#F5F4FA</color>
    <color name="pulse_light_nav">#FFFFFF</color>
    <color name="pulse_light_surface">#FFFFFF</color>
    <color name="pulse_light_surface_raised">#F1EEF9</color>
    <color name="pulse_light_surface_overlay">#FFFFFF</color>
    <color name="pulse_light_surface_hover">#E8E4F4</color>
    <color name="pulse_light_border">#E3DEF0</color>
    <color name="pulse_light_outline">#6D6690</color>
    <color name="pulse_light_text_primary">#1A1626</color>
    <color name="pulse_light_text_secondary">#574F74</color>
    <color name="pulse_light_text_muted">#6A6288</color>
    <color name="pulse_light_text_disabled">#A29BC0</color>
    <color name="pulse_light_accent">#6D28D9</color>
    <color name="pulse_light_accent_alt">#0E7490</color>
    <color name="pulse_light_accent_tint">#EDE9FE</color>
    <color name="pulse_light_work">#147536</color>
    <color name="pulse_light_work_tint">#E7F5EB</color>
    <color name="pulse_light_rest">#0369A1</color>
    <color name="pulse_light_rest_tint">#E4F1F8</color>
    <color name="pulse_light_prepare">#965B06</color>
    <color name="pulse_light_prepare_tint">#FAF1DE</color>
    <color name="pulse_light_cooldown">#7E22CE</color>
    <color name="pulse_light_cooldown_tint">#F3EAFD</color>
    <color name="pulse_light_destructive">#BE123C</color>
    <color name="pulse_light_destructive_tint">#FCE9EE</color>
    <color name="pulse_light_neutral_fill">#EAE6F6</color>
    <color name="pulse_light_cat_cardio">#BE123C</color>
    <color name="pulse_light_cat_cardio_tint">#FCE9EE</color>
    <color name="pulse_light_cat_conditioning">#965B06</color>
    <color name="pulse_light_cat_conditioning_tint">#FAF1DE</color>
    <color name="pulse_light_cat_strength">#6D28D9</color>
    <color name="pulse_light_cat_strength_tint">#EDE9FE</color>
    <color name="pulse_light_cat_mobility">#0369A1</color>
    <color name="pulse_light_cat_mobility_tint">#E4F1F8</color>
    <color name="pulse_light_cat_mind">#147536</color>
    <color name="pulse_light_cat_mind_tint">#E7F5EB</color>
    <color name="pulse_light_cat_tools">#475569</color>
    <color name="pulse_light_cat_tools_tint">#E9EDF3</color>
    <color name="pulse_light_action_fill">#1A1626</color>
    <color name="pulse_light_action_text">#FFFFFF</color>
    <color name="pulse_light_on_accent">#FFFFFF</color>

    <!-- ============================ Void — the OLED theme ============================ -->
    <!-- Only the surfaces change: pure black saves power on OLED panels, and the ramp above already
         clears every threshold against #000000 (verified as its own section in docs/CONTRAST.md). -->

    <color name="pulse_black_canvas">#000000</color>
    <color name="pulse_black_nav">#000000</color>
    <color name="pulse_black_surface">#0B0A14</color>
    <color name="pulse_black_surface_raised">#14121F</color>
    <color name="pulse_black_surface_overlay">#1B1826</color>
    <color name="pulse_black_surface_hover">#221F30</color>
    <color name="pulse_black_border">#1D1A2A</color>

    <!-- ============================ Widgets ============================ -->
    <!-- RemoteViews can only reference resources, so the widget surfaces are aliases rather than
         copies: change the design system and the home-screen widget follows automatically. -->

    <color name="widget_background">@color/pulse_surface</color>
    <color name="widget_row_background">@color/pulse_surface_raised</color>
    <color name="widget_phase_work">@color/pulse_work</color>
    <color name="widget_phase_rest">@color/pulse_rest</color>
    <color name="widget_phase_prepare">@color/pulse_prepare</color>

</resources>
