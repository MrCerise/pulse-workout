<?xml version="1.0" encoding="utf-8"?>
<!--
  CADENCE design tokens — the "Momentum" system.

  Signal is a dashboard palette, not a decoration palette. Chrome is neutral: a
  rich charcoal ramp for the dark theme, a clean paper ramp for the light one, and hairlines
  instead of shadows. The accent is volt lime (#A3E635) — one loud hue against quiet ink — and it is spent
  deliberately: the brand mark, the one primary action per screen, the selected navigation item
  and the focus ring. Everything else that carries colour is a *meaning* — an interval phase, a
  workout category, a state — never decoration.

  Every value here is mirrored, name for name, in ui/theme/Palette.kt; scripts/contrast_check.py
  exits 2 if the two ever drift apart and exits 1 if any measured pairing drops below its WCAG 2.1
  AA threshold. docs/DESIGN.md says which token belongs where; docs/CONTRAST.md holds the numbers.

  Dark is the default. Each theme is built from the same roles, so a component never has to know
  which theme it is in — it reads semantic tokens from PulseColors and the resolution happens once,
  in Theme.kt.
-->
<resources>

    <!-- ============================ Ink — the default (dark) theme ============================ -->
    <!--
      A neutral charcoal ramp, deliberately *not* pure black: five steps that are close together,
      because hierarchy comes from a fill step plus a hairline rather than from brightness jumps.
      `surface_sunken` is the one step *below* the canvas, for wells and inset tables.
    -->
    <color name="pulse_canvas">#101216</color>
    <color name="pulse_nav">#14161B</color>
    <color name="pulse_surface">#181B20</color>
    <color name="pulse_surface_raised">#1E2126</color>
    <color name="pulse_surface_overlay">#23262C</color>
    <color name="pulse_surface_hover">#2A2E34</color>
    <color name="pulse_surface_sunken">#121418</color>

    <!-- Borders. `pulse_border` is a hairline separator and is intentionally low-contrast (it is
         decorative); `pulse_outline` marks a meaningful control boundary and clears 3:1;
         `pulse_border_strong` is the edge of a filled input, one step louder than a hairline. -->
    <color name="pulse_border">#2E323A</color>
    <color name="pulse_border_strong">#3B4048</color>
    <color name="pulse_outline">#8A9099</color>

    <!-- Text. Four levels, three of which clear 4.5:1; `disabled` is exempt by WCAG and exists so
         that "unavailable" is visually distinct from "quiet" rather than merely dimmer. -->
    <color name="pulse_text_primary">#F4F6F8</color>
    <color name="pulse_text_secondary">#C3C7CC</color>
    <color name="pulse_text_muted">#9CA2A9</color>
    <color name="pulse_text_disabled">#6E747C</color>
    <!-- Track behind sliders, rings and chart baselines. Visible, never competing with the fill. -->
    <color name="pulse_track">#3A3E45</color>

    <!-- The accent. `pulse_accent` (orange) is the interactive colour: links, selection, focus and
         live data. `pulse_accent_alt` is its lighter partner, drawn only as a graphic (a bar, a
         sweep, a rank badge), never as a label. `pulse_accent_tint` is the pre-composited container
         accent text is measured against. -->
    <color name="pulse_accent">#A3E635</color>
    <color name="pulse_accent_alt">#D9F99D</color>
    <color name="pulse_accent_tint">#232B10</color>

    <!-- The brand fill and the ink that sits on it. One pair, used by the primary action and the
         wordmark — the only place in the interface where a solid block of brand colour appears. -->
    <color name="pulse_brand">#A3E635</color>
    <color name="pulse_on_brand">#101216</color>

    <!-- The ink panel. A deliberately dark surface that stays dark in both themes, so a hero card
         reads as a feature panel rather than as another card in the stack. -->
    <color name="pulse_hero_surface">#131519</color>
    <color name="pulse_hero_text">#F4F6F8</color>
    <color name="pulse_hero_muted">#A8B0BA</color>

    <!-- Interval phases. One hue per phase, each shipped with the pre-composited container tint it
         is drawn on. -->
    <color name="pulse_work">#4CC38A</color>
    <color name="pulse_work_tint">#1D2D28</color>
    <color name="pulse_rest">#6CABF8</color>
    <color name="pulse_rest_tint">#212A36</color>
    <color name="pulse_prepare">#F5B544</color>
    <color name="pulse_prepare_tint">#322B20</color>
    <color name="pulse_cooldown">#B18CFA</color>
    <color name="pulse_cooldown_tint">#292636</color>
    <color name="pulse_destructive">#F87171</color>
    <color name="pulse_destructive_tint">#322325</color>
    <color name="pulse_neutral_fill">#2E3138</color>

    <!-- Informational state. Deliberately a different hue from the accent: "here is something you
         should read" is not the same message as "here is the thing to do". -->
    <color name="pulse_info">#7CB7FF</color>
    <color name="pulse_info_tint">#232B36</color>

    <!-- Workout category hues. Six families, one hue each, each with the pre-composited container
         tint it is drawn on, so "this is a cardio session" reads before a word is read. -->
    <color name="pulse_cat_cardio">#F0607A</color>
    <color name="pulse_cat_cardio_tint">#312126</color>
    <color name="pulse_cat_conditioning">#F5B544</color>
    <color name="pulse_cat_conditioning_tint">#322B20</color>
    <color name="pulse_cat_strength">#B18CFA</color>
    <color name="pulse_cat_strength_tint">#292636</color>
    <color name="pulse_cat_mobility">#5BA8F5</color>
    <color name="pulse_cat_mobility_tint">#1F2935</color>
    <color name="pulse_cat_mind">#4CC38A</color>
    <color name="pulse_cat_mind_tint">#1D2D28</color>
    <color name="pulse_cat_tools">#98A2B3</color>
    <color name="pulse_cat_tools_tint">#26292D</color>

    <!-- Solid action surfaces: the brand fill with the ink label measured against it. -->
    <color name="pulse_action_fill">#A3E635</color>
    <color name="pulse_action_text">#101216</color>
    <color name="pulse_on_accent">#101216</color>

    <!-- ============================ Paper — the light theme ============================ -->
    <!--
      The same roles with inverted polarity: a clean near-white canvas, white surfaces, hairline
      borders. The `light_accent` is a deeper orange than the brand fill because it carries *text*
      (links, selected labels, the focus ring) and must clear 4.5:1 on white, while the brand fill
      carries ink and can stay the true #F38020.
    -->
    <color name="pulse_light_canvas">#F4F6F8</color>
    <color name="pulse_light_nav">#FFFFFF</color>
    <color name="pulse_light_surface">#FFFFFF</color>
    <color name="pulse_light_surface_raised">#F7F8FA</color>
    <color name="pulse_light_surface_overlay">#FFFFFF</color>
    <color name="pulse_light_surface_hover">#EBEEF1</color>
    <color name="pulse_light_surface_sunken">#EFF2F5</color>
    <color name="pulse_light_border">#E3E7EB</color>
    <color name="pulse_light_border_strong">#CBD2D9</color>
    <color name="pulse_light_outline">#6B7280</color>
    <color name="pulse_light_text_primary">#1B1E21</color>
    <color name="pulse_light_text_secondary">#4B5157</color>
    <color name="pulse_light_text_muted">#666C74</color>
    <color name="pulse_light_text_disabled">#A6ACB3</color>
    <color name="pulse_light_track">#E3E5E8</color>
    <color name="pulse_light_accent">#3F6212</color>
    <color name="pulse_light_accent_alt">#365314</color>
    <color name="pulse_light_accent_tint">#F1F5E1</color>
    <color name="pulse_light_brand">#A3E635</color>
    <color name="pulse_light_on_brand">#101216</color>
    <color name="pulse_light_hero_surface">#131519</color>
    <color name="pulse_light_hero_text">#F4F6F8</color>
    <color name="pulse_light_hero_muted">#A8B0BA</color>
    <color name="pulse_light_work">#12603C</color>
    <color name="pulse_light_work_tint">#E7EFEC</color>
    <color name="pulse_light_rest">#0A56A8</color>
    <color name="pulse_light_rest_tint">#E6EEF6</color>
    <color name="pulse_light_prepare">#7A5100</color>
    <color name="pulse_light_prepare_tint">#F2EEE6</color>
    <color name="pulse_light_cooldown">#5B21B6</color>
    <color name="pulse_light_cooldown_tint">#EFE9F8</color>
    <color name="pulse_light_destructive">#A8291F</color>
    <color name="pulse_light_destructive_tint">#F6EAE9</color>
    <color name="pulse_light_neutral_fill">#E9EBEE</color>
    <color name="pulse_light_info">#0B57C2</color>
    <color name="pulse_light_info_tint">#E7EEF9</color>
    <color name="pulse_light_cat_cardio">#A3123A</color>
    <color name="pulse_light_cat_cardio_tint">#F6E7EB</color>
    <color name="pulse_light_cat_conditioning">#7A5100</color>
    <color name="pulse_light_cat_conditioning_tint">#F2EEE6</color>
    <color name="pulse_light_cat_strength">#5B21B6</color>
    <color name="pulse_light_cat_strength_tint">#EFE9F8</color>
    <color name="pulse_light_cat_mobility">#0A5C8A</color>
    <color name="pulse_light_cat_mobility_tint">#E6EFF3</color>
    <color name="pulse_light_cat_mind">#106544</color>
    <color name="pulse_light_cat_mind_tint">#E7F0EC</color>
    <color name="pulse_light_cat_tools">#3F4753</color>
    <color name="pulse_light_cat_tools_tint">#ECEDEE</color>
    <color name="pulse_light_action_fill">#A3E635</color>
    <color name="pulse_light_action_text">#101216</color>
    <color name="pulse_light_on_accent">#101216</color>

    <!-- ============================ Void — the OLED theme ============================ -->
    <!-- Only the surfaces change: pure black saves power on OLED panels, and the ramp above already
         clears every threshold against #000000 (verified as its own section in docs/CONTRAST.md). -->

    <color name="pulse_black_canvas">#000000</color>
    <color name="pulse_black_nav">#000000</color>
    <color name="pulse_black_surface">#0B0C0E</color>
    <color name="pulse_black_surface_raised">#131518</color>
    <color name="pulse_black_surface_overlay">#17191D</color>
    <color name="pulse_black_surface_hover">#1E2024</color>
    <color name="pulse_black_surface_sunken">#0B0C0E</color>
    <color name="pulse_black_border">#23262A</color>

    <!-- ============================ Widgets ============================ -->
    <!-- RemoteViews can only reference resources, so the widget surfaces are aliases rather than
         copies: change the design system and the home-screen widget follows automatically. -->

    <color name="widget_background">@color/pulse_surface</color>
    <color name="widget_row_background">@color/pulse_surface_raised</color>
    <color name="widget_phase_work">@color/pulse_work</color>
    <color name="widget_phase_rest">@color/pulse_rest</color>
    <color name="widget_phase_prepare">@color/pulse_prepare</color>

</resources>
