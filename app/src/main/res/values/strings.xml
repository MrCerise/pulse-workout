    <!-- Help -->
    <string name="help_title">Help</string>
    <string name="help_voice">Voice setup</string>
    <string name="help_voice_body">PULSE uses the text-to-speech engine installed on your device. For coaching that works in flight mode, install an offline voice: Android Settings → System → Languages &amp; input → Text-to-speech → your engine → Install voice data. If no engine is present, PULSE falls back to sound cues and tells you in Voice Studio.</string>
    <string name="help_background">Background operation</string>
    <string name="help_background_body">A workout runs in a foreground service with a media notification, so timing and cues continue when the screen is off or you switch apps. Android may still restart the process in extreme low-memory situations — if that happens, PULSE reports the session as interrupted instead of pretending it completed.</string>
    <string name="help_audio">Audio troubleshooting</string>
    <string name="help_audio_body">Cues are mixed at the volume you set in Voice Studio. If you cannot hear them, check that media volume is up, that Do Not Disturb is not blocking media, and that PULSE is not muted in the notification shade. Music from other apps is ducked rather than stopped.</string>
    <string name="help_import">Imported files</string>
    <string name="help_import_body">Exports are plain JSON files. Importing shows a preview and never overwrites existing workouts: imported copies get new IDs, and identical names are suffixed. If a referenced image or audio file has been deleted, the workout still loads and reports the missing media.</string>
    <string name="help_gestures">Player shortcuts</string>
    <string name="help_gestures_body">Space toggles pause (with a hardware keyboard), ↑/↓ adjust volume, and N/M jump to next/previous interval. Volume-key control can be enabled in Settings.</string>
    <string name="help_accessibility">Accessibility</string>
    <string name="help_accessibility_body">Every drag action has Move up / Move down alternatives, controls are at least 48 dp, phase colours always come with a text label, and TalkBack announces interval changes instead of every tick.</string>

