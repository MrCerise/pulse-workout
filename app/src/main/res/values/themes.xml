<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Compose owns every in-app style; these platform themes only cover the window background, the
      splash window and the system bars, so there is no white flash between process start and the
      first Compose frame. Both colours are design tokens, not literals.
    -->
    <style name="Theme.Pulse" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/pulse_canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
    </style>

    <style name="Theme.Pulse.Splash" parent="Theme.Pulse">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <style name="Theme.Pulse.Light" parent="Theme.Pulse">
        <item name="android:windowBackground">@color/pulse_light_canvas</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
